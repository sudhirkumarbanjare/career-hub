# ==========================================
# GoTechPlace Ecosystem - .gitignore
# Prevents junk data, binaries, caches & secrets
# ==========================================

# 1. OS & System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 2. Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# 3. Metro Bundler & Build Caches
.metro/
metro-cache/
.metro-health-check*
*.tsbuildinfo
.eslintcache
.prettiercache
.stylelintcache
.cache/
.parcel-cache/
.turbo/

# 4. Web & General Build Outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
*.local

# 5. Android Build Artifacts, SDK & Gradle Junk
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/app/.cxx/
**/android/local.properties
**/android/key.properties
*.apk
*.ap_
*.aab
*.dex
*.keystore
*.jks
**/android/app/src/main/assets/index.android.bundle.meta
**/android/app/src/main/assets/index.android.bundle.map

# 6. iOS Artifacts (if applicable)
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcuserdatad/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# 7. IDEs, Editors & Tools
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvsopt
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
*.bak
*.orig
*.rej
.project
.classpath
.cproject
.settings/

# 8. Environment Variables, Credentials & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
serviceAccountKey*.json
service-account*.json
firebase-adminsdk*.json
*secret*
*credential*

# 9. Test Coverage, Diagnostics, Temp & Assistant Storage
coverage/
*.lcov
.nyc_output/
.temp/
.tmp/
tmp/
temp/
scratch/
*.tmp
*.temp
.tempmediaStorage/
*.log
logs/

# 10. Miscellaneous Unnecessary Files
Projects.pdf
*.pdf.tmp
