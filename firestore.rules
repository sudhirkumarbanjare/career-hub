rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'gotechplace@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users can only read and write their own profile data, but admin can read and update all
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      
      // Users can only access their own bookings and enrollments
      match /bookings/{bookingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /enrollments/{enrollmentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Allow admins to read collection groups
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAdmin();
    }
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isAdmin();
    }

    // 2. Catalogs are PUBLIC to read (anyone can view projects/jobs/courses)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
