# ==============================================================================
# GOTECHPLACE PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FIREBASE WEB SDK CONFIGURATION
# Obtain from: Firebase Console → Project Settings → Your Apps → Web App
# ------------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSy_YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# GOOGLE OAUTH (Firebase Auth — set in Firebase Console, not here)
# Firebase Auth handles Google Sign-In internally.
# You just need to enable "Google" in Firebase Console → Authentication
# → Sign-in method → Google → Enable
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# LEGACY: Google Sheets (No longer needed after Firebase migration)
# Kept as reference — can be deleted
# ------------------------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID=your-old-oauth-client-id.apps.googleusercontent.com
# VITE_GOOGLE_SHEETS_ID=your-spreadsheet-id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ==============================================================================
# FIRESTORE COLLECTIONS REFERENCE
# ==============================================================================
#
# /users/{uid}                       — Student profile (uses Firebase Auth UID)
# /users/{uid}/bookings/{id}         — Project bookings (subcollection)
# /users/{uid}/enrollments/{id}      — Course enrollments (subcollection)
# /projects/{projectId}              — Project catalog (admin seeded)
# /jobs/{jobId}                      — Job listings (admin seeded)
# /courses/{courseId}                — Course catalog (admin seeded)
#
# Seed with: node scripts/seedFirebase.js
# ==============================================================================
