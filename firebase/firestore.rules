rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['superuser', 'admin', 'staff', 'moderator', 'support'] ||
        getUserData().role in ['superuser', 'admin', 'staff', 'moderator', 'support']
      );
    }

    function isSuperuser() {
      return isAuthenticated() && (
        request.auth.token.role == 'superuser' ||
        getUserData().role == 'superuser'
      );
    }

    function isApprovedClient() {
      return isAuthenticated() && (
        getUserData().role == 'client' &&
        getUserData().isApproved == true
      );
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Any authenticated user can read user docs or admin can read all
      allow read: if isAuthenticated();

      // User can create their initial profile, but CANNOT self-assign admin roles or auto-approve
      allow create: if isUser(userId)
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['student', 'client'])
                    && (!request.resource.data.keys().hasAny(['isApproved']) || request.resource.data.isApproved == (request.resource.data.role == 'student'))
                    && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'active');

      // User can update their own profile fields, but NEVER change role, approval, or suspension
      allow update: if (isUser(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved', 'status', 'uid']))
                    || isAdmin();

      allow delete: if isSuperuser();

      // Multi-device tokens
      match /devices/{deviceId} {
        allow read, write: if isUser(userId) || isAdmin();
      }
    }

    // ----------------------------------------------------
    // STUDENTS COLLECTION
    // ----------------------------------------------------
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(studentId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // CLIENTS COLLECTION
    // ----------------------------------------------------
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      // Client cannot self-approve
      allow create: if isUser(clientId) && request.resource.data.approvalStatus == 'pending';
      allow update: if (isUser(clientId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'rejectionReason']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // JOBS COLLECTION
    // ----------------------------------------------------
    match /jobs/{jobId} {
      // Students and public can only read approved jobs
      // Clients can read their own jobs
      // Admins can read all jobs
      allow read: if resource.data.approvalStatus == 'approved'
                  || (isAuthenticated() && resource.data.clientId == request.auth.uid)
                  || isAdmin();

      // Only approved clients can create jobs (starts as draft or pending_approval)
      allow create: if isApprovedClient()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.approvalStatus in ['pending', 'draft'];

      // Client can only edit their pending/draft jobs, cannot self-approve
      allow update: if (isAuthenticated()
                        && resource.data.clientId == request.auth.uid
                        && resource.data.approvalStatus in ['pending', 'draft']
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt']))
                    || isAdmin();

      allow delete: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isAdmin();
    }

    // ----------------------------------------------------
    // APPLICATIONS COLLECTION
    // ----------------------------------------------------
    match /applications/{applicationId} {
      // Students can read their own applications
      // Clients can read applications for their jobs
      // Admins can read all
      allow read: if (isAuthenticated() && resource.data.studentId == request.auth.uid)
                  || (isAuthenticated() && resource.data.clientId == request.auth.uid)
                  || isAdmin();

      // Students can submit applications
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;

      // Clients can update status of applications for their jobs, admin can update all
      allow update: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // PROJECTS & BOOKINGS (CareerPath Features)
    // ----------------------------------------------------
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projectBookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.student_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // COURSES & ENROLLMENTS (CareerPath Features)
    // ----------------------------------------------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courseEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.student_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // CATEGORIES
    // ----------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // REPORTS
    // ----------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // NOTIFICATIONS
    // ----------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    match /notificationCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------
    // AUDIT LOGS (Immutable)
    // ----------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable! No one can tamper with logs
    }

    // ----------------------------------------------------
    // APP VERSIONS & FORCE UPDATE
    // ----------------------------------------------------
    match /appVersions/{appId} {
      allow read: if true; // Any client app needs to read its version configuration on launch
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // SYSTEM SETTINGS & FEATURE FLAGS
    // ----------------------------------------------------
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // ROLES & STAFF
    // ----------------------------------------------------
    match /roles/{roleId} {
      allow read, write: if isSuperuser();
    }

    match /staff/{staffId} {
      allow read: if isAdmin();
      allow write: if isSuperuser();
    }
  }
}
