{
  "name": "gotechplace-ecosystem",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:lint": "npm run lint --prefix website",
    "student:start": "npm start --prefix student",
    "client:start": "npm start --prefix client",
    "admin:start": "npm start --prefix admin",
    "student:android": "npm run android --prefix student",
    "client:android": "npm run android --prefix client",
    "admin:android": "npm run android --prefix admin",
    "student:apk": "cd student/android && ./gradlew assembleDebug",
    "client:apk": "cd client/android && ./gradlew assembleDebug",
    "admin:apk": "cd admin/android && ./gradlew assembleDebug",
    "apks:build-all": "npm run student:apk && npm run client:apk && npm run admin:apk",
    "install:apks": "./scripts/install_all_apks.sh"
  },
  "workspaces": [
    "website",
    "shared",
    "student",
    "client",
    "admin",
    "firebase/functions"
  ],
  "dependencies": {
    "@react-native-community/cli": "^15.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native-community/cli-tools": "^15.0.1",
    "@react-native/metro-config": "^0.76.7",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.73.0",
    "chalk": "^4.1.2",
    "typescript": "^5.7.3"
  }
}
